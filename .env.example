# Copia este archivo a .env (no se sube a git) y llena los valores.

# --- PostgreSQL ---
POSTGRES_USER=sidapa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sidapa

# --- JWT --- llave para firmar el token (mínimo 32 caracteres)
JWT_KEY=change-me-at-least-32-characters-long

# --- Google Cloud Storage ---
GCS_BUCKET_NAME=
# JSON del service account codificado en Base64 (una sola línea). Para generarlo:
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#   Linux/macOS: base64 -w0 service-account.json
GCS_CREDENTIALS_BASE64=

# --- Lector de facturas (sidapa-reader, entorno aparte) ---
# Por defecto el reader publicado en el puerto 8000 del host. En otro servidor: http://<host>:8000
TAXSCAN_BASE_URL=http://host.docker.internal:8000

# --- Opcionales ---
# Contraseña de los usuarios de prueba <rol>@sidapa.local (solo con ASPNETCORE_ENVIRONMENT=Development)
DEV_USERS_PASSWORD=
# SMTP; si EMAIL_HOST o EMAIL_FROM quedan vacíos los correos solo se escriben en el log
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
