@model SIDAPA.application.DTOs.Core.Pedimento.PedimentoDto
@using SIDAPA.presentation.Models

@* Renglón de "Próximos a vencer" en Inicio; lleva al detalle del pedimento. *@
<a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3"
   asp-controller="Pedimentos" asp-action="Detalle" asp-route-id="@Model.Id">
    <span class="flex-grow-1 overflow-hidden">
        <span class="d-block font-monospace fw-semibold text-truncate">@Model.Numero</span>
        <span class="d-block small text-body-secondary text-truncate">@Model.Empresa</span>
    </span>
    <span class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
        <span class="badge rounded-pill text-bg-@Model.Urgencia.ColorBootstrap()">@Model.Urgencia.Etiqueta()</span>
        <time class="small text-body-secondary" datetime="@Model.FechaLimite.Iso()">@Model.FechaLimite.Texto()</time>
    </span>
</a>
