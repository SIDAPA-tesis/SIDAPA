@model IEnumerable<SIDAPA.presentation.Models.Dashboard.Usuario>
@{
    ViewData["Title"] = "Usuarios";
    Layout = "_dashboardLayout";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Administración de usuarios</h1>
        <p class="text-body-secondary mb-0">Usuarios con acceso a SIDAPA y su rol.</p>
    </div>

    @* TODO: enlazar a la acción para crear un usuario *@
    <button type="button" class="btn btn-primary">Agregar usuario</button>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle text-nowrap mb-0">
            <thead>
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Correo</th>
                    <th scope="col">Rol</th>
                    <th scope="col">Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td>@usuario.Nombre</td>
                        <td>@usuario.Correo</td>
                        <td>@usuario.Rol</td>
                        <td>
                            <span class="badge rounded-pill @(usuario.Activo ? "text-bg-success" : "text-bg-secondary")">
                                @(usuario.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
