@model SIDAPA.presentation.Models.Core.Notifications.NovedadViewModel

<li class="col">
    <article class="card h-100 shadow-sm @(Model.Nueva ? "border-primary" : null)">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                <time class="small text-body-secondary" datetime="@Model.Fecha.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture)">
                    @Model.Fecha.ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)
                </time>
                @if (Model.Nueva)
                {
                    <span class="badge text-bg-primary">Nueva</span>
                }
            </div>
            <p class="card-text mb-0">@Model.Mensaje</p>
        </div>
    </article>
</li>
