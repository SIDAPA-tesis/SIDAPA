<!DOCTYPE html>
<html lang="es" class="sidapa-html">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - SIDAPA</title>

    @* Va en línea a propósito: aplica el tema guardado antes del primer pintado (si esperara a tema.js, parpadea). *@
    <script>
        try {
            document.documentElement.setAttribute("data-bs-theme", localStorage.getItem("tema") || "light");
        } catch (e) { }
    </script>

    @* Bootstrap local y la paleta primero; los estilos de la portada y de cada pantalla van después. *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/base/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/landingPage/inicio-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/landingPage/inicio-hero.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/landingPage/inicio-secciones.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="sidapa-pagina">

    <header class="sidapa-nav">

        @* Logo provisional (diseño lo está haciendo). Colores en inicio-base.css (.sidapa-logo__*). *@
        <a class="sidapa-nav__marca" asp-controller="Home" asp-action="Index">
            <svg class="sidapa-nav__logo" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
                <defs>
                    <linearGradient id="sidapa-logo-cielo" x1="0" y1="0" x2="0" y2="1">
                        <stop class="sidapa-logo__cielo-arriba" offset="0" />
                        <stop class="sidapa-logo__cielo-abajo" offset="1" />
                    </linearGradient>
                    <clipPath id="sidapa-logo-recorte"><circle cx="18" cy="18" r="18" /></clipPath>
                </defs>
                <g clip-path="url(#sidapa-logo-recorte)">
                    <rect width="36" height="36" fill="url(#sidapa-logo-cielo)" />
                    <ellipse class="sidapa-logo__suelo" cx="18" cy="38" rx="26" ry="12" />
                </g>
            </svg>
            <span>SIDAPA</span>
        </a>

        @* Menú del usuario (dropdown de Bootstrap con data-bs-*, sin JS propio). *@
        <div class="dropdown">
            <button type="button"
                    class="sidapa-nav__usuario dropdown-toggle"
                    id="dropdownUsuario"
                    data-bs-toggle="dropdown"
                    aria-label="Cuenta de usuario"
                    aria-expanded="false">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor"
                     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="10" />
                    <circle cx="12" cy="10" r="3" />
                    <path d="M6.2 18.5c1.3-2.3 3.4-3.5 5.8-3.5s4.5 1.2 5.8 3.5" />
                </svg>
            </button>

            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="dropdownUsuario">
                <li>
                    <div class="dropdown-header">
                        <strong>@User.Identity?.Name</strong><br />
                        <small class="text-body-secondary">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                    </div>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <button type="button" class="dropdown-item" id="cambiarTema">Cambiar tema</button>
                </li>
                <li>
                    <form asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm">
                        <button type="submit" class="dropdown-item text-danger">Cerrar sesión</button>
                    </form>
                </li>
            </ul>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    @* ===================== PIE DE PÁGINA ===================== *@
    <footer class="sidapa-pie">
        <div class="sidapa-contenedor">
            <small>© @DateTime.Now.Year SIDAPA</small>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/tema.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
