@*
    Panel del administrador en Inicio. DATOS DE EJEMPLO: cuando haya servicio de indicadores, este partial
    recibe un @model y los valores salen de ahí. Solo Bootstrap (es partial: sin CSS propio).
*@

<section class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-3" aria-label="Indicadores principales">
    @foreach (var (titulo, icono, valor, nota, avance, color) in new[]
    {
        ("Total de pedimentos", "▤", "1,282", "Registros acumulados", 85, "primary"),
        ("En proceso", "◷", "146", "Pendientes de concluir", 45, "warning"),
        ("Completados", "✓", "1,084", "Procesos finalizados", 80, "success"),
        ("Con incidencias", "!", "52", "Requieren revisión", 25, "danger"),
    })
    {
        <div class="col">
            <article class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center small text-body-secondary">
                        <span>@titulo</span>
                        <span class="badge fs-6 bg-@color-subtle text-@color-emphasis" aria-hidden="true">@icono</span>
                    </div>
                    <strong class="d-block fs-3 mt-3 lh-1">@valor</strong>
                    <small class="d-block text-body-secondary mt-2">@nota</small>
                    <div class="progress mt-3" role="progressbar" aria-label="@titulo"
                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="@avance" style="height: 0.3rem">
                        <div class="progress-bar bg-@color" style="width: @avance%"></div>
                    </div>
                </div>
            </article>
        </div>
    }
</section>

<section class="row g-3 mb-3">
    <div class="col-12 col-xl-7">
        <article class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <h2 class="h6 mb-1">Actividad de pedimentos</h2>
                        <p class="small text-body-secondary mb-0">Resumen mensual de ejemplo</p>
                    </div>
                    <span class="badge bg-body border text-body-secondary fw-normal">Últimos 6 meses</span>
                </div>

                <div role="img" aria-label="Gráfica ilustrativa de actividad mensual">
                    @foreach (var (mes, total, ancho) in new[]
                    {
                        ("Mayo", 75, 63), ("Junio", 92, 77), ("Julio", 84, 70),
                        ("Agosto", 110, 92), ("Septiembre", 98, 82), ("Octubre", 120, 100),
                    })
                    {
                        <div class="row g-2 align-items-center small mb-2">
                            <span class="col-3 text-body-secondary">@mes</span>
                            <div class="col">
                                <div class="progress"><div class="progress-bar" style="width: @ancho%"></div></div>
                            </div>
                            <b class="col-2 col-sm-1 text-end">@total</b>
                        </div>
                    }
                </div>
            </div>
        </article>
    </div>

    <div class="col-12 col-xl-5">
        <article class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h6 mb-1">Estado general</h2>
                <p class="small text-body-secondary mb-3">Distribución ilustrativa</p>

                @foreach (var (estado, porcentaje, color) in new[]
                {
                    ("Completados", 84.6m, "success"), ("En proceso", 11.4m, "primary"), ("Con incidencias", 4m, "danger"),
                })
                {
                    var texto = porcentaje.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-body-secondary">@estado</span><b>@texto%</b>
                        </div>
                        <div class="progress" style="height: 0.3rem">
                            <div class="progress-bar bg-@color" style="width: @texto%"></div>
                        </div>
                    </div>
                }

                <div class="bg-body-tertiary rounded p-3 mt-4">
                    <strong class="small">Resumen del sistema</strong>
                    <p class="small text-body-secondary mb-0 mt-1">Esta sección puede mostrar alertas, pendientes o información prioritaria para el administrador.</p>
                </div>
            </div>
        </article>
    </div>
</section>

<section class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <h2 class="h6 mb-1">Actividad reciente</h2>
        <p class="small text-body-secondary mb-3">Registros de demostración; sustituye estos datos por los reales.</p>
        <div class="table-responsive">
            <table class="table table-hover align-middle text-nowrap small mb-0">
                <thead><tr><th scope="col">Identificador</th><th scope="col">Descripción</th><th scope="col">Estado</th><th scope="col">Actualización</th></tr></thead>
                <tbody>
                    <tr><td class="fw-semibold">PED-2026-1042</td><td>Pedimento de importación</td><td><span class="badge rounded-pill text-bg-success">Completado</span></td><td>Recientemente</td></tr>
                    <tr><td class="fw-semibold">PED-2026-1041</td><td>Pedimento de exportación</td><td><span class="badge rounded-pill text-bg-warning">En proceso</span></td><td>Recientemente</td></tr>
                    <tr><td class="fw-semibold">PED-2026-1040</td><td>Revisión documental</td><td><span class="badge rounded-pill text-bg-danger">Incidencia</span></td><td>Recientemente</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>
