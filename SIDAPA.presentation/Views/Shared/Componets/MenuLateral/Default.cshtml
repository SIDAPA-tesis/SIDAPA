@model SIDAPA.presentation.Models.MenuLateralViewModel

@* Bloque de usuario (icono + nombre) y opciones según el rol. Estilos: css/dashboard-extensiones.css *@
<div class="menu-usuario">
    <svg class="menu-usuario__icono" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="10" />
        <circle cx="12" cy="10" r="3" />
        <path d="M6.2 18.5c1.3-2.3 3.4-3.5 5.8-3.5s4.5 1.2 5.8 3.5" />
    </svg>
    <div class="menu-usuario__datos">
        <span class="menu-usuario__nombre">@Model.Nombre</span>
        <span class="menu-usuario__rol">@Model.Rol</span>
    </div>
</div>

<nav aria-label="Menú principal">
    @foreach (var opcion in Model.Opciones)
    {
        <a asp-controller="@opcion.Controlador"
           asp-action="Index"
           class="@(opcion.Activa ? "active" : null)"
           aria-current="@(opcion.Activa ? "page" : null)">@opcion.Texto</a>
    }
</nav>
