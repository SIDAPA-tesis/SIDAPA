@*
    Menú lateral del dashboard. Las opciones por rol salen del ViewComponent MenuLateral (IPermisosService):
    no agregues ligas aquí; un módulo nuevo va en ModuloEnum + PermisosService + ModuloCatalogo.
*@
<div class="brand">SIDAPA</div>

@await Component.InvokeAsync("MenuLateral")

<div class="logout-section">
    <form asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm">
        <button type="submit" class="logout-btn">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Cerrar Sesión
        </button>
    </form>
</div>
