@model IEnumerable<SIDAPA.presentation.Models.Dashboard.ReporteMensual>

@{
    Layout = "_dashboardLayout";
    ViewData["Title"] = "Reporte";
    var maximo = Model.Any() ? Model.Max(r => r.Altas) : 0;
}

<h1 class="h3 mb-1">Altas de pedimento</h1>
<p class="text-body-secondary mb-4">Pedimentos totales del mes</p>

<div class="card border-0 shadow-sm">
    <ul class="list-group list-group-flush">
        @foreach (var fila in Model)
        {
            var porcentaje = maximo == 0 ? 0 : fila.Altas * 100 / maximo;

            <li class="list-group-item d-flex align-items-center gap-3">
                <span class="flex-shrink-0 text-body-secondary font-monospace">@fila.Mes</span>
                <div class="progress flex-grow-1" role="progressbar" aria-label="Altas de @fila.Mes"
                     aria-valuemin="0" aria-valuemax="@maximo" aria-valuenow="@fila.Altas">
                    <div class="progress-bar" style="width: @(porcentaje)%"></div>
                </div>
                <b class="flex-shrink-0 text-end font-monospace">@fila.Altas</b>
            </li>
        }
    </ul>
</div>
