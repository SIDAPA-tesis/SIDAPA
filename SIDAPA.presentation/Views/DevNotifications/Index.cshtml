@model SIDAPA.presentation.Models.Dev.DevNotificationViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Prueba de avisos";
}
<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow rounded-4 p-4 mb-4">
                <h1 class="h4 fw-bold mb-3">
                    Avisos (SCRUM-59)
                    <span class="badge text-bg-primary align-middle">@Model.UnreadCount sin leer</span>
                </h1>

                <form asp-action="Index" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <label asp-for="Message" class="form-label">Mensaje (se manda a ti mismo)</label>
                    <textarea asp-for="Message" class="form-control mb-2" rows="3"></textarea>

                    <div class="form-check mb-3">
                        <input asp-for="SendEmail" class="form-check-input" />
                        <label asp-for="SendEmail" class="form-check-label">Enviar también por correo</label>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill px-4">Enviar aviso</button>
                </form>
            </div>

            <div class="list-group shadow-sm">
                @if (Model.Notifications.Count == 0)
                {
                    <div class="list-group-item text-secondary">No tienes avisos.</div>
                }
                @foreach (var n in Model.Notifications)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div class="@(n.IsRead ? "text-secondary" : "fw-semibold")" style="white-space: pre-line">@n.Message</div>
                            <small class="text-secondary">@n.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</small>
                        </div>
                        @if (!n.IsRead)
                        {
                            <form asp-action="MarkAsRead" asp-route-id="@n.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill">Marcar leída</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</main>