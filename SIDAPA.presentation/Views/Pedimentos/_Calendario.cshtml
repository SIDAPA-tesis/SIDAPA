@model CalendarioViewModel

@* Calendario mensual generado en el servidor. Estilos: Bootstrap + css/vistas/pedimentos.css (de la página). *@
<section class="card border-0 shadow-sm" aria-labelledby="calendario-titulo">
    <div class="card-body">

        <header class="d-flex justify-content-between align-items-center mb-3">
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-all-route-data="@Model.Ruta(Model.MesAnterior)" aria-label="Mes anterior">&lsaquo;</a>
            <h2 class="h6 mb-0" id="calendario-titulo">@Model.Titulo</h2>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-all-route-data="@Model.Ruta(Model.MesSiguiente)" aria-label="Mes siguiente">&rsaquo;</a>
        </header>

        <ol class="calendario list-unstyled small text-body-secondary text-uppercase fw-semibold mb-1" aria-hidden="true">
            @foreach (var nombre in CalendarioViewModel.DiasSemana)
            {
                <li>@nombre</li>
            }
        </ol>

        <ol class="calendario list-unstyled small mb-3">
            @foreach (var dia in Model.Dias)
            {
                var clases = "calendario__dia rounded"
                    + (dia.EnMes ? "" : " text-body-tertiary")
                    + (dia.EsHoy ? " calendario__dia--hoy fw-bold" : "")
                    + (dia.Urgencia is { } urgencia ? $" fw-semibold bg-{urgencia.ColorBootstrap()}-subtle text-{urgencia.ColorBootstrap()}-emphasis" : "");

                <li class="@clases">
                    <time datetime="@dia.Fecha.Iso()">@dia.Fecha.Day</time>
                    @if (dia.Vencimientos.Count > 0)
                    {
                        <span class="visually-hidden">@dia.Vencimientos.Count @(dia.Vencimientos.Count == 1 ? "pedimento vence" : "pedimentos vencen") este día</span>
                    }
                </li>
            }
        </ol>

        <ul class="list-unstyled d-flex flex-wrap gap-3 small text-body-secondary mb-3" aria-label="Leyenda de colores">
            <li class="d-flex align-items-center gap-1"><span class="calendario__marca rounded-circle bg-danger" aria-hidden="true"></span>Vencido</li>
            <li class="d-flex align-items-center gap-1"><span class="calendario__marca rounded-circle bg-warning" aria-hidden="true"></span>Próximo (7 días)</li>
            <li class="d-flex align-items-center gap-1"><span class="calendario__marca rounded-circle bg-success" aria-hidden="true"></span>En tiempo</li>
            <li class="d-flex align-items-center gap-1"><span class="calendario__marca rounded-circle bg-secondary" aria-hidden="true"></span>Completado</li>
        </ul>

        <h3 class="h6 border-top pt-3">Fechas límite del mes</h3>

        @if (Model.Vencimientos.Count == 0)
        {
            <p class="small text-body-secondary mb-0">Ningún pedimento vence este mes.</p>
        }
        else
        {
            <ul class="list-group list-group-flush small">
                @foreach (var vence in Model.Vencimientos)
                {
                    <li class="list-group-item px-0 d-flex align-items-center gap-2">
                        <span class="text-body-secondary">@vence.FechaLimite.TextoCorto()</span>
                        <a class="font-monospace flex-grow-1 text-truncate" asp-action="Detalle" asp-route-id="@vence.Id">@vence.Numero</a>
                        <span class="badge rounded-pill text-bg-@vence.Urgencia.ColorBootstrap()">@vence.Urgencia.Etiqueta()</span>
                    </li>
                }
            </ul>
        }
    </div>
</section>
