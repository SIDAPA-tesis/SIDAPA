@model SIDAPA.application.DTOs.Core.Pedimento.PedimentoDto

@{
    Layout = "_dashboardLayout";
    ViewData["Title"] = "Pedimento";
}

@section Styles {
    <link rel="stylesheet" href="~/css/vistas/pedimentos.css" asp-append-version="true" />
}

<div class="container-fluid py-3">

    <a class="btn btn-sm btn-link px-0 mb-2" asp-action="Index">&larr; Volver a pedimentos</a>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
        <h1 class="h3 mb-0 font-monospace">@Model.Numero</h1>
        <span class="badge rounded-pill text-bg-@Model.Urgencia.ColorBootstrap()">@Model.Urgencia.Etiqueta()</span>
    </div>
    <p class="text-body-secondary mb-4">@Model.Empresa</p>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-12 col-sm-4 col-lg-3">Fecha límite</dt>
                <dd class="col-12 col-sm-8 col-lg-9">
                    <time datetime="@Model.FechaLimite.Iso()">@Model.FechaLimite.Texto()</time>
                </dd>

                <dt class="col-12 col-sm-4 col-lg-3">Avance</dt>
                <dd class="col-12 col-sm-8 col-lg-9 mb-0">
                    <div class="d-flex align-items-center gap-2">
                        <div class="tarjeta-pedimento__avance progress flex-grow-1" role="progressbar" aria-label="Avance del pedimento"
                             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Model.Avance">
                            <div class="progress-bar" style="width: @(Model.Avance)%"></div>
                        </div>
                        <span class="small fw-semibold">@Model.Avance %</span>
                    </div>
                </dd>
            </dl>
        </div>
    </div>

    @* AQUÍ VA LA VISTA COMPLETA DEL PEDIMENTO (destino de las cards) *@
</div>
