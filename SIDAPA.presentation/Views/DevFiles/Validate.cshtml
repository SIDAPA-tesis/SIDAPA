@model SIDAPA.presentation.Models.Dev.DevFileViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Prueba de archivos";
}
<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow rounded-4 p-4">
                <h1 class="h4 fw-bold mb-3">Validación de archivos (SCRUM-50)</h1>

                <form asp-action="Validate" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    @if (Model.Result is not null)
                    {
                        <div class="alert alert-success py-2 small" role="status">@Model.Result</div>
                    }

                    <input asp-for="File" class="form-control mb-2" />
                    <span asp-validation-for="File" class="invalid-feedback d-block mb-2"></span>

                    <button type="submit" class="btn btn-primary rounded-pill px-4">Validar</button>
                </form>
            </div>
        </div>
    </div>
</main>