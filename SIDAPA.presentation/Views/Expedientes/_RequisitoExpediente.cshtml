@model RequisitoExpedienteViewModel

<li class="list-group-item d-flex justify-content-between align-items-start gap-2">
    <div class="overflow-hidden">
        <p class="mb-0">@Model.Nombre</p>
        <p class="small text-body-secondary mb-0">@(Model.Obligatorio ? "Obligatorio" : "Opcional")</p>
    </div>
    <span class="badge rounded-pill text-bg-@Model.Color">@Model.Etiqueta</span>
</li>
